{
  "name": "agri-supply-chain-blockchain",
  "version": "1.0.0",
  "description": "Blockchain-Based Supply Chain Transparency for Agricultural Produce",
  "main": "index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "test": "jest",
    "deploy:contracts": "truffle migrate --network development",
    "compile:contracts": "truffle compile"
  },
  "keywords": [
    "blockchain",
    "supply-chain",
    "agriculture",
    "transparency",
    "traceability",
    "ethereum",
    "smart-contracts"
  ],
  "author": "Agricultural Supply Chain Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.7.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "ganache-cli": "^6.12.2",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "truffle": "^5.4.29",
    "web3": "^4.1.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@truffle/hdwallet-provider": "^2.1.15",
    "concurrently": "^8.2.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
